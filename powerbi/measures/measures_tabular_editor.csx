// ICU / Repeat ICU Stays (same admission)
m = t.Measures.Contains(@"Repeat ICU Stays (same admission)") ? t.Measures[@"Repeat ICU Stays (same admission)"] : t.AddMeasure(@"Repeat ICU Stays (same admission)");
m.Expression = @"CALCULATE ( [ICU Stays], fact_icu_stays[is_repeat_icu_stay_same_admission] = TRUE () )";
