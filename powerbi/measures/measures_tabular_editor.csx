)";
m.DisplayFolder = @"Volume";
m.FormatString = @"0.0%";
m.Description = @"Share of admissions whose admission_group is Emergency. Denominator: all admissions in context.";

// Volume / ED Visit %
m = t.Measures.Contains(@"ED Visit %") ? t.Measures[@"ED Visit %"] : t.AddMeasure(@"ED Visit %");
m.Expression = @"DIVIDE (
    CALCULATE ( [Total Admissions], fact_admissions[had_ed_visit] = TRUE () ),
    [Total Admissions]
)";
m.DisplayFolder = @"Volume";
m.FormatString = @"0.0%";
m.Description = @"Share of admissions with an emergency department visit (had_ed_visit).";

// Volume\Display / Total Patients (display)
m = t.Measures.Contains(@"Total Patients (display)") ? t.Measures[@"Total Patients (display)"] : t.AddMeasure(@"Total Patients (display)");
m.Expression = @"VAR n = [Total Patients]
RETURN
    IF ( n > 0 && n < [Min Cell Size], ""<"" & [Min Cell Size], FORMAT ( n, ""#,0"" ) )";
m.DisplayFolder = @"Volume\Display";
m.FormatString = @"";
m.Description = @"Small-cell-aware label for Total Patients (""<5"" when 1-4).";

// Volume\Display / Total Admissions (display)
m = t.Measures.Contains(@"Total Admissions (display)") ? t.Measures[@"Total Admissions (display)"] : t.AddMeasure(@"Total Admissions (display)");
m.Expression = @"VAR n = [Total Admissions]
RETURN
