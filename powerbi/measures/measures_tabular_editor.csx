m.DisplayFolder = @"Volume\Display";
m.FormatString = @"";
m.Description = @"Small-cell-aware label for Total Admissions (""<5"" when 1-4).";

// LOS / Median LOS (days)
m = t.Measures.Contains(@"Median LOS (days)") ? t.Measures[@"Median LOS (days)"] : t.AddMeasure(@"Median LOS (days)");
m.Expression = @"PERCENTILE.INC ( fact_admissions[los_days], 0.5 )";
m.DisplayFolder = @"LOS";
m.FormatString = @"0.00";
m.Description = @"Median of los_days = PERCENTILE.INC(0.5). SQL: percentile_cont(0.5).";

// LOS / Mean LOS (days)
m = t.Measures.Contains(@"Mean LOS (days)") ? t.Measures[@"Mean LOS (days)"] : t.AddMeasure(@"Mean LOS (days)");
m.Expression = @"AVERAGE ( fact_admissions[los_days] )";
m.DisplayFolder = @"LOS";
m.FormatString = @"0.00";
m.Description = @"Arithmetic mean of los_days (skewed by long stays; prefer the median).";

// LOS / LOS P25 (days)
m = t.Measures.Contains(@"LOS P25 (days)") ? t.Measures[@"LOS P25 (days)"] : t.AddMeasure(@"LOS P25 (days)");
m.Expression = @"PERCENTILE.INC ( fact_admissions[los_days], 0.25 )";
m.DisplayFolder = @"LOS";
m.FormatString = @"0.00";
m.Description = @"25th percentile of los_days (PERCENTILE.INC = percentile_cont).";

// LOS / LOS P75 (days)
m = t.Measures.Contains(@"LOS P75 (days)") ? t.Measures[@"LOS P75 (days)"] : t.AddMeasure(@"LOS P75 (days)");
m.Expression = @"PERCENTILE.INC ( fact_admissions[los_days], 0.75 )";
m.DisplayFolder = @"LOS";
m.FormatString = @"0.00";
m.Description = @"75th percentile of los_days.";

// LOS / LOS P90 (days)
m = t.Measures.Contains(@"LOS P90 (days)") ? t.Measures[@"LOS P90 (days)"] : t.AddMeasure(@"LOS P90 (days)");
m.Expression = @"PERCENTILE.INC ( fact_admissions[los_days], 0.90 )";
m.DisplayFolder = @"LOS";
m.FormatString = @"0.00";
