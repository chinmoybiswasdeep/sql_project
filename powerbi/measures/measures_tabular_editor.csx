        VALUES ( fact_admissions[subject_id] ),
        CALCULATE ( COUNTROWS ( fact_admissions ) ) > 1
    )
)";
m.DisplayFolder = @"Volume";
m.FormatString = @"#,0";
m.Description = @"Patients with more than one admission inside the current filter context.";

// Volume / Repeat Patient %
m = t.Measures.Contains(@"Repeat Patient %") ? t.Measures[@"Repeat Patient %"] : t.AddMeasure(@"Repeat Patient %");
m.Expression = @"DIVIDE ( [Repeat Patients], [Total Patients] )";
m.DisplayFolder = @"Volume";
m.FormatString = @"0.0%";
m.Description = @"Repeat Patients / Total Patients.";

// Volume / Emergency Admission %
m = t.Measures.Contains(@"Emergency Admission %") ? t.Measures[@"Emergency Admission %"] : t.AddMeasure(@"Emergency Admission %");
m.Expression = @"DIVIDE (
