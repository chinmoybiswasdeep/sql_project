// Outcomes / Hospital Mortality % CI Lower
m = t.Measures.Contains(@"Hospital Mortality % CI Lower") ? t.Measures[@"Hospital Mortality % CI Lower"] : t.AddMeasure(@"Hospital Mortality % CI Lower");
m.Expression = @"VAR x = [Hospital Deaths]
VAR n = [Total Admissions]
VAR z = 1.959964
VAR p = DIVIDE ( x, n )
VAR d = 1 + DIVIDE ( z ^ 2, n )
VAR centre = DIVIDE ( p + DIVIDE ( z ^ 2, 2 * n ), d )
VAR half = DIVIDE ( z * SQRT ( DIVIDE ( p * ( 1 - p ), n ) + DIVIDE ( z ^ 2, 4 * n ^ 2 ) ), d )
RETURN
    IF ( n > 0, MAX ( 0, centre - half ) )";
m.DisplayFolder = @"Outcomes";
m.FormatString = @"0.0%";
m.Description = @"Wilson score 95% CI lower bound for Hospital Mortality % (x = Hospital Deaths, n = Total Admissions, z = 1.959964).";

