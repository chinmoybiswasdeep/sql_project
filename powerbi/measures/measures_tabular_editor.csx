var t = Model.Tables["_Measures"];
Measure m;

// Volume / Total Patients
m = t.Measures.Contains(@"Total Patients") ? t.Measures[@"Total Patients"] : t.AddMeasure(@"Total Patients");
m.Expression = @"DISTINCTCOUNT ( fact_admissions[subject_id] )";
m.DisplayFolder = @"Volume";
m.FormatString = @"#,0";
m.Description = @"Distinct patients (fact_admissions[subject_id]) with an admission in the current filter context. SQL: count(distinct subject_id) from fact_admissions.";

// Volume / Total Admissions
m = t.Measures.Contains(@"Total Admissions") ? t.Measures[@"Total Admissions"] : t.AddMeasure(@"Total Admissions");
m.Expression = @"COUNTROWS ( fact_admissions )";
m.DisplayFolder = @"Volume";
m.FormatString = @"#,0";
m.Description = @"Hospital admissions = rows of fact_admissions (grain hadm_id).";

// Volume / Admissions per Patient
m = t.Measures.Contains(@"Admissions per Patient") ? t.Measures[@"Admissions per Patient"] : t.AddMeasure(@"Admissions per Patient");
m.Expression = @"DIVIDE ( [Total Admissions], [Total Patients] )";
m.DisplayFolder = @"Volume";
m.FormatString = @"0.00";
m.Description = @"Admissions / distinct patients, both from fact_admissions.";

// Volume / Repeat Patients
m = t.Measures.Contains(@"Repeat Patients") ? t.Measures[@"Repeat Patients"] : t.AddMeasure(@"Repeat Patients");
m.Expression = @"COUNTROWS (
