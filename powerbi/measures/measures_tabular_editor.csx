VAR centre = DIVIDE ( p + DIVIDE ( z ^ 2, 2 * n ), d )
VAR half = DIVIDE ( z * SQRT ( DIVIDE ( p * ( 1 - p ), n ) + DIVIDE ( z ^ 2, 4 * n ^ 2 ) ), d )
RETURN
    IF ( n > 0, MIN ( 1, centre + half ) )";
m.DisplayFolder = @"Readmission";
m.FormatString = @"0.0%";
m.Description = @"Wilson score 95% CI upper bound for Readmission 30d %.";

// Readmission / Unplanned Readmissions 30d
m = t.Measures.Contains(@"Unplanned Readmissions 30d") ? t.Measures[@"Unplanned Readmissions 30d"] : t.AddMeasure(@"Unplanned Readmissions 30d");
m.Expression = @"CALCULATE (
