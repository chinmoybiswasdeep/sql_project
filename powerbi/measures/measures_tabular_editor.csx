VAR n = [ICU Stays]
VAR z = 1.959964
VAR p = DIVIDE ( x, n )
VAR d = 1 + DIVIDE ( z ^ 2, n )
VAR centre = DIVIDE ( p + DIVIDE ( z ^ 2, 2 * n ), d )
VAR half = DIVIDE ( z * SQRT ( DIVIDE ( p * ( 1 - p ), n ) + DIVIDE ( z ^ 2, 4 * n ^ 2 ) ), d )
RETURN
    IF ( n > 0, MAX ( 0, centre - half ) )";
m.DisplayFolder = @"Outcomes";
m.FormatString = @"0.0%";
m.Description = @"Wilson score 95% CI lower bound for ICU Mortality % (x = ICU Deaths, n = ICU Stays).";

// Outcomes / ICU Mortality % CI Upper
m = t.Measures.Contains(@"ICU Mortality % CI Upper") ? t.Measures[@"ICU Mortality % CI Upper"] : t.AddMeasure(@"ICU Mortality % CI Upper");
m.Expression = @"VAR x = [ICU Deaths]
VAR n = [ICU Stays]
VAR z = 1.959964
VAR p = DIVIDE ( x, n )
VAR d = 1 + DIVIDE ( z ^ 2, n )
VAR centre = DIVIDE ( p + DIVIDE ( z ^ 2, 2 * n ), d )
VAR half = DIVIDE ( z * SQRT ( DIVIDE ( p * ( 1 - p ), n ) + DIVIDE ( z ^ 2, 4 * n ^ 2 ) ), d )
RETURN
    IF ( n > 0, MIN ( 1, centre + half ) )";
