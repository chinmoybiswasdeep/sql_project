)";
m.DisplayFolder = @"LOS";
m.FormatString = @"0.0%";
m.Description = @"Share of admissions with los_days >= 14 (the ""14+ days"" band).";

// LOS / Short Stay % (<1 day)
m = t.Measures.Contains(@"Short Stay % (<1 day)") ? t.Measures[@"Short Stay % (<1 day)"] : t.AddMeasure(@"Short Stay % (<1 day)");
