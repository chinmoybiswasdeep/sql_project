    )
)";
m.DisplayFolder = @"ICU";
m.FormatString = @"0.0%";
m.Description = @"Share of all ICU days in the current context, e.g. per first care unit. Denominator: ICU days with care-unit filters removed.";

// ICU / Median ICU LOS (days)
m = t.Measures.Contains(@"Median ICU LOS (days)") ? t.Measures[@"Median ICU LOS (days)"] : t.AddMeasure(@"Median ICU LOS (days)");
m.Expression = @"PERCENTILE.INC ( fact_icu_stays[icu_los_days], 0.5 )";
m.DisplayFolder = @"ICU";
m.FormatString = @"0.00";
m.Description = @"Median ICU length of stay in days per ICU stay (PERCENTILE.INC 0.5).";

// ICU / Mean ICU LOS (days)
m = t.Measures.Contains(@"Mean ICU LOS (days)") ? t.Measures[@"Mean ICU LOS (days)"] : t.AddMeasure(@"Mean ICU LOS (days)");
m.Expression = @"AVERAGE ( fact_icu_stays[icu_los_days] )";
m.DisplayFolder = @"ICU";
m.FormatString = @"0.00";
