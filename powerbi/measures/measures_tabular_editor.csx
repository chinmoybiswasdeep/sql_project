m.FormatString = @"0.0%";
m.Description = @"Share of admissions with los_days < 1 (the ""<1 day"" band).";

// ICU / ICU Admissions
m = t.Measures.Contains(@"ICU Admissions") ? t.Measures[@"ICU Admissions"] : t.AddMeasure(@"ICU Admissions");
m.Expression = @"CALCULATE ( [Total Admissions], fact_admissions[had_icu_stay] = TRUE () )";
m.DisplayFolder = @"ICU";
m.FormatString = @"#,0";
m.Description = @"Admissions with at least one ICU stay (fact_admissions[had_icu_stay]).";

// ICU / ICU Admission %
m = t.Measures.Contains(@"ICU Admission %") ? t.Measures[@"ICU Admission %"] : t.AddMeasure(@"ICU Admission %");
m.Expression = @"DIVIDE ( [ICU Admissions], [Total Admissions] )";
m.DisplayFolder = @"ICU";
m.FormatString = @"0.0%";
m.Description = @"ICU Admissions / Total Admissions. Denominator: all admissions in context.";

// ICU / ICU Stays
m = t.Measures.Contains(@"ICU Stays") ? t.Measures[@"ICU Stays"] : t.AddMeasure(@"ICU Stays");
m.Expression = @"COUNTROWS ( fact_icu_stays )";
m.DisplayFolder = @"ICU";
m.FormatString = @"#,0";
m.Description = @"ICU stays = rows of fact_icu_stays (grain stay_id). One admission can have several stays, so ICU Stays >= ICU Admissions.";

// ICU / ICU Patients
m = t.Measures.Contains(@"ICU Patients") ? t.Measures[@"ICU Patients"] : t.AddMeasure(@"ICU Patients");
m.Expression = @"DISTINCTCOUNT ( fact_icu_stays[subject_id] )";
m.DisplayFolder = @"ICU";
m.FormatString = @"#,0";
m.Description = @"Distinct patients with an ICU stay (fact_icu_stays[subject_id]).";

// ICU / ICU Stays per ICU Admission
m = t.Measures.Contains(@"ICU Stays per ICU Admission") ? t.Measures[@"ICU Stays per ICU Admission"] : t.AddMeasure(@"ICU Stays per ICU Admission");
m.Expression = @"DIVIDE ( [ICU Stays], [ICU Admissions] )";
m.DisplayFolder = @"ICU";
m.FormatString = @"0.00";
m.Description = @"ICU stays / ICU admissions.";

// ICU / Total ICU Days
m = t.Measures.Contains(@"Total ICU Days") ? t.Measures[@"Total ICU Days"] : t.AddMeasure(@"Total ICU Days");
m.Expression = @"SUM ( fact_icu_stays[icu_los_days] )";
