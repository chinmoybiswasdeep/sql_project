m.FormatString = @"0.00";
m.Description = @"Interquartile range of los_days = P75 - P25.";

// LOS / Total Bed Days
m = t.Measures.Contains(@"Total Bed Days") ? t.Measures[@"Total Bed Days"] : t.AddMeasure(@"Total Bed Days");
m.Expression = @"SUM ( fact_admissions[los_days] )";
m.DisplayFolder = @"LOS";
m.FormatString = @"#,0.0";
m.Description = @"Sum of los_days: total bed-days consumed (resource proxy).";

// LOS / Long Stay % (14+ days)
m = t.Measures.Contains(@"Long Stay % (14+ days)") ? t.Measures[@"Long Stay % (14+ days)"] : t.AddMeasure(@"Long Stay % (14+ days)");
m.Expression = @"DIVIDE (
