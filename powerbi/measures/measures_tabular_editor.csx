m.FormatString = @"#,0.0";
m.Description = @"Sum of fact_icu_stays[icu_los_days]: ICU days consumed (utilisation, NOT occupancy; there is no bed-capacity data).";

// ICU / ICU Days Share
m = t.Measures.Contains(@"ICU Days Share") ? t.Measures[@"ICU Days Share"] : t.AddMeasure(@"ICU Days Share");
m.Expression = @"DIVIDE (
    [Total ICU Days],
