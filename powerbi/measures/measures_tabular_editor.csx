m.DisplayFolder = @"Readmission";
m.FormatString = @"#,0";
m.Description = @"Eligible index admissions followed within 30 days by an UNPLANNED (non-elective) admission (is_unplanned_readmitted_30d).";

// Readmission / Unplanned Readmission 30d %
m = t.Measures.Contains(@"Unplanned Readmission 30d %") ? t.Measures[@"Unplanned Readmission 30d %"] : t.AddMeasure(@"Unplanned Readmission 30d %");
m.Expression = @"DIVIDE ( [Unplanned Readmissions 30d], [Eligible Index Admissions] )";
m.DisplayFolder = @"Readmission";
m.FormatString = @"0.0%";
m.Description = @"Unplanned Readmissions 30d / Eligible Index Admissions.";

// Readmission / Unplanned Readmission 30d % CI Lower
m = t.Measures.Contains(@"Unplanned Readmission 30d % CI Lower") ? t.Measures[@"Unplanned Readmission 30d % CI Lower"] : t.AddMeasure(@"Unplanned Readmission 30d % CI Lower");
m.Expression = @"VAR x = [Unplanned Readmissions 30d]
VAR n = [Eligible Index Admissions]
VAR z = 1.959964
VAR p = DIVIDE ( x, n )
VAR d = 1 + DIVIDE ( z ^ 2, n )
VAR centre = DIVIDE ( p + DIVIDE ( z ^ 2, 2 * n ), d )
VAR half = DIVIDE ( z * SQRT ( DIVIDE ( p * ( 1 - p ), n ) + DIVIDE ( z ^ 2, 4 * n ^ 2 ) ), d )
RETURN
    IF ( n > 0, MAX ( 0, centre - half ) )";
m.DisplayFolder = @"Readmission";
m.FormatString = @"0.0%";
m.Description = @"Wilson score 95% CI lower bound for Unplanned Readmission 30d %.";

// Readmission / Unplanned Readmission 30d % CI Upper
m = t.Measures.Contains(@"Unplanned Readmission 30d % CI Upper") ? t.Measures[@"Unplanned Readmission 30d % CI Upper"] : t.AddMeasure(@"Unplanned Readmission 30d % CI Upper");
m.Expression = @"VAR x = [Unplanned Readmissions 30d]
VAR n = [Eligible Index Admissions]
VAR z = 1.959964
VAR p = DIVIDE ( x, n )
VAR d = 1 + DIVIDE ( z ^ 2, n )
VAR centre = DIVIDE ( p + DIVIDE ( z ^ 2, 2 * n ), d )
VAR half = DIVIDE ( z * SQRT ( DIVIDE ( p * ( 1 - p ), n ) + DIVIDE ( z ^ 2, 4 * n ^ 2 ) ), d )
RETURN
    IF ( n > 0, MIN ( 1, centre + half ) )";
m.DisplayFolder = @"Readmission";
m.FormatString = @"0.0%";
m.Description = @"Wilson score 95% CI upper bound for Unplanned Readmission 30d %.";

// Readmission / Readmissions within 24h
m = t.Measures.Contains(@"Readmissions within 24h") ? t.Measures[@"Readmissions within 24h"] : t.AddMeasure(@"Readmissions within 24h");
m.Expression = @"CALCULATE (
    COUNTROWS ( fact_readmissions ),
    fact_readmissions[is_readmitted_within_24h] = TRUE ()
)";
m.DisplayFolder = @"Readmission";
m.FormatString = @"#,0";
m.Description = @"Eligible index admissions readmitted within 24 hours of discharge.";

// Readmission / Median Days to Readmission
m = t.Measures.Contains(@"Median Days to Readmission") ? t.Measures[@"Median Days to Readmission"] : t.AddMeasure(@"Median Days to Readmission");
m.Expression = @"CALCULATE (
    PERCENTILE.INC ( fact_readmissions[days_to_next_admission], 0.5 ),
    fact_readmissions[is_readmitted_30d] = TRUE ()
)";
m.DisplayFolder = @"Readmission";
m.FormatString = @"0.0";
m.Description = @"Median days from index discharge to the next admission, over 30-day readmissions only.";

// Readmission\Display / Readmissions 30d (display)
m = t.Measures.Contains(@"Readmissions 30d (display)") ? t.Measures[@"Readmissions 30d (display)"] : t.AddMeasure(@"Readmissions 30d (display)");
m.Expression = @"VAR n = [Readmissions 30d]
RETURN
    IF ( n > 0 && n < [Min Cell Size], ""<"" & [Min Cell Size], FORMAT ( n, ""#,0"" ) )";
m.DisplayFolder = @"Readmission\Display";
m.FormatString = @"";
m.Description = @"Small-cell-aware label for Readmissions 30d.";

// Readmission\Display / Readmissions within 24h (display)
m = t.Measures.Contains(@"Readmissions within 24h (display)") ? t.Measures[@"Readmissions within 24h (display)"] : t.AddMeasure(@"Readmissions within 24h (display)");
m.Expression = @"VAR n = [Readmissions within 24h]
RETURN
    IF ( n > 0 && n < [Min Cell Size], ""<"" & [Min Cell Size], FORMAT ( n, ""#,0"" ) )";
m.DisplayFolder = @"Readmission\Display";
m.FormatString = @"";
m.Description = @"Small-cell-aware label for Readmissions within 24h.";

// Readmission\Display / Excluded Index Admissions (display)
m = t.Measures.Contains(@"Excluded Index Admissions (display)") ? t.Measures[@"Excluded Index Admissions (display)"] : t.AddMeasure(@"Excluded Index Admissions (display)");
m.Expression = @"VAR n = [Excluded Index Admissions]
RETURN
    IF ( n > 0 && n < [Min Cell Size], ""<"" & [Min Cell Size], FORMAT ( n, ""#,0"" ) )";
m.DisplayFolder = @"Readmission\Display";
m.FormatString = @"";
m.Description = @"Small-cell-aware label for Excluded Index Admissions (e.g. per exclusion_reason).";

// Readmission\Display / Readmission 30d % (display)
m = t.Measures.Contains(@"Readmission 30d % (display)") ? t.Measures[@"Readmission 30d % (display)"] : t.AddMeasure(@"Readmission 30d % (display)");
m.Expression = @"VAR x = [Readmissions 30d]
VAR n = [Eligible Index Admissions]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( n ), BLANK (),
        ( x > 0 && x < [Min Cell Size] ) || n < [Min Cell Size], ""Suppressed (n<"" & [Min Cell Size] & "")"",
        FORMAT ( [Readmission 30d %], ""0.0%"" )
    )";
m.DisplayFolder = @"Readmission\Display";
m.FormatString = @"";
m.Description = @"Readmission 30d % as text, suppressed when the numerator is a small cell or the eligible denominator is below Min Cell Size.";

// Readmission\Display / Readmission 30d % with CI (display)
m = t.Measures.Contains(@"Readmission 30d % with CI (display)") ? t.Measures[@"Readmission 30d % with CI (display)"] : t.AddMeasure(@"Readmission 30d % with CI (display)");
m.Expression = @"VAR x = [Readmissions 30d]
VAR n = [Eligible Index Admissions]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( n ), BLANK (),
        ( x > 0 && x < [Min Cell Size] ) || n < [Min Cell Size], ""Suppressed (n<"" & [Min Cell Size] & "")"",
        FORMAT ( [Readmission 30d %], ""0.0%"" ) & "" (95% CI ""
            & FORMAT ( [Readmission 30d % CI Lower], ""0.0%"" ) & ""-""
            & FORMAT ( [Readmission 30d % CI Upper], ""0.0%"" ) & ""), ""
            & FORMAT ( x, ""#,0"" ) & ""/"" & FORMAT ( n, ""#,0"" )
    )";
m.DisplayFolder = @"Readmission\Display";
m.FormatString = @"";
m.Description = @"Tooltip text: ""20.4% (95% CI 15.9%-25.8%), 52/255"", suppressed for small cells.";

// Clinical / Diagnoses
m = t.Measures.Contains(@"Diagnoses") ? t.Measures[@"Diagnoses"] : t.AddMeasure(@"Diagnoses");
m.Expression = @"COUNTROWS ( fact_diagnoses )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Billed diagnoses = rows of fact_diagnoses (grain hadm_id, seq_num).";

// Clinical / Diagnoses per Admission
m = t.Measures.Contains(@"Diagnoses per Admission") ? t.Measures[@"Diagnoses per Admission"] : t.AddMeasure(@"Diagnoses per Admission");
m.Expression = @"DIVIDE ( [Diagnoses], [Total Admissions] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0";
m.Description = @"Diagnoses / Total Admissions (all admissions in context, including any without a coded diagnosis).";

// Clinical / Admissions with Diagnosis
m = t.Measures.Contains(@"Admissions with Diagnosis") ? t.Measures[@"Admissions with Diagnosis"] : t.AddMeasure(@"Admissions with Diagnosis");
m.Expression = @"DISTINCTCOUNT ( fact_diagnoses[hadm_id] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Admissions with at least one diagnosis in the current context (e.g. per diagnosis category).";

// Clinical / % Admissions with Diagnosis
m = t.Measures.Contains(@"% Admissions with Diagnosis") ? t.Measures[@"% Admissions with Diagnosis"] : t.AddMeasure(@"% Admissions with Diagnosis");
m.Expression = @"DIVIDE ( [Admissions with Diagnosis], [Total Admissions] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0%";
m.Description = @"Admissions with Diagnosis / all admissions in context. Because dim_diagnosis does not filter fact_admissions, the denominator stays all admissions.";

// Clinical / Distinct ICD Codes
m = t.Measures.Contains(@"Distinct ICD Codes") ? t.Measures[@"Distinct ICD Codes"] : t.AddMeasure(@"Distinct ICD Codes");
m.Expression = @"DISTINCTCOUNT ( fact_diagnoses[diagnosis_key] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Distinct ICD codes (version-qualified diagnosis_key) used in fact_diagnoses.";

// Clinical / Lab Events
m = t.Measures.Contains(@"Lab Events") ? t.Measures[@"Lab Events"] : t.AddMeasure(@"Lab Events");
m.Expression = @"COUNTROWS ( fact_lab_events )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"All lab measurements (rows of fact_lab_events), inpatient AND outpatient. Any filter from dim_patient / fact_admissions drops outpatient rows (hadm_id blank), so use Admission-Linked Lab Events for per-admission work.";

// Clinical / Admission-Linked Lab Events
m = t.Measures.Contains(@"Admission-Linked Lab Events") ? t.Measures[@"Admission-Linked Lab Events"] : t.AddMeasure(@"Admission-Linked Lab Events");
m.Expression = @"CALCULATE ( [Lab Events], fact_lab_events[is_admission_linked] = TRUE () )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Lab measurements linked to an admission (is_admission_linked = hadm_id not null).";

// Clinical / Labs per Admission
m = t.Measures.Contains(@"Labs per Admission") ? t.Measures[@"Labs per Admission"] : t.AddMeasure(@"Labs per Admission");
m.Expression = @"DIVIDE ( [Admission-Linked Lab Events], [Total Admissions] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0.0";
m.Description = @"Admission-linked lab events / Total Admissions (= mean of fact_admissions[n_lab_events]).";

// Clinical / Abnormal Lab Events
m = t.Measures.Contains(@"Abnormal Lab Events") ? t.Measures[@"Abnormal Lab Events"] : t.AddMeasure(@"Abnormal Lab Events");
m.Expression = @"CALCULATE ( [Lab Events], fact_lab_events[flag_abnormal] = TRUE () )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Lab results flagged abnormal by the laboratory (flag_abnormal).";

// Clinical / Abnormal Lab %
m = t.Measures.Contains(@"Abnormal Lab %") ? t.Measures[@"Abnormal Lab %"] : t.AddMeasure(@"Abnormal Lab %");
m.Expression = @"DIVIDE ( [Abnormal Lab Events], [Lab Events] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0%";
m.Description = @"Abnormal Lab Events / Lab Events (all results, as in SQL query 17). An abnormal value is a measurement property, not a diagnosis.";

// Clinical / Low Result %
m = t.Measures.Contains(@"Low Result %") ? t.Measures[@"Low Result %"] : t.AddMeasure(@"Low Result %");
m.Expression = @"DIVIDE (
    CALCULATE ( [Lab Events], fact_lab_events[range_direction] = ""low"" ),
    CALCULATE ( [Lab Events], NOT ISBLANK ( fact_lab_events[range_direction] ) )
)";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0%";
m.Description = @"Results below their own reference range / range-evaluable results (range_direction not blank).";

// Clinical / High Result %
m = t.Measures.Contains(@"High Result %") ? t.Measures[@"High Result %"] : t.AddMeasure(@"High Result %");
m.Expression = @"DIVIDE (
    CALCULATE ( [Lab Events], fact_lab_events[range_direction] = ""high"" ),
    CALCULATE ( [Lab Events], NOT ISBLANK ( fact_lab_events[range_direction] ) )
)";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0%";
m.Description = @"Results above their own reference range / range-evaluable results.";

// Clinical / Medication Orders (all)
m = t.Measures.Contains(@"Medication Orders (all)") ? t.Measures[@"Medication Orders (all)"] : t.AddMeasure(@"Medication Orders (all)");
m.Expression = @"COUNTROWS ( fact_medication_orders )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"All prescription orders (rows of fact_medication_orders), including diluents/base solutions and flushes. Orders, not administrations.";

// Clinical / Therapeutic Orders
m = t.Measures.Contains(@"Therapeutic Orders") ? t.Measures[@"Therapeutic Orders"] : t.AddMeasure(@"Therapeutic Orders");
m.Expression = @"CALCULATE (
    [Medication Orders (all)],
    fact_medication_orders[drug_type] <> ""BASE"",
    NOT CONTAINSSTRING ( fact_medication_orders[drug_name_normalized], ""flush"" )
)";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Therapeutic orders: excludes drug_type = ""BASE"" and drug names containing ""flush"" (CONTAINSSTRING is case-insensitive; names are lower-case). Same filter as SQL query 19.";

// Clinical / Distinct Therapeutic Drugs
m = t.Measures.Contains(@"Distinct Therapeutic Drugs") ? t.Measures[@"Distinct Therapeutic Drugs"] : t.AddMeasure(@"Distinct Therapeutic Drugs");
m.Expression = @"CALCULATE (
    DISTINCTCOUNT ( fact_medication_orders[medication_key] ),
    fact_medication_orders[drug_type] <> ""BASE"",
    NOT CONTAINSSTRING ( fact_medication_orders[drug_name_normalized], ""flush"" )
)";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Distinct therapeutic drugs (medication_key) ordered.";

// Clinical / Admissions Exposed
m = t.Measures.Contains(@"Admissions Exposed") ? t.Measures[@"Admissions Exposed"] : t.AddMeasure(@"Admissions Exposed");
m.Expression = @"CALCULATE (
    DISTINCTCOUNT ( fact_medication_orders[hadm_id] ),
    fact_medication_orders[drug_type] <> ""BASE"",
    NOT CONTAINSSTRING ( fact_medication_orders[drug_name_normalized], ""flush"" )
)";
m.DisplayFolder = @"Clinical";
m.FormatString = @"#,0";
m.Description = @"Admissions with at least one therapeutic order of the drug(s) in context.";

// Clinical / % Admissions Exposed
m = t.Measures.Contains(@"% Admissions Exposed") ? t.Measures[@"% Admissions Exposed"] : t.AddMeasure(@"% Admissions Exposed");
m.Expression = @"DIVIDE ( [Admissions Exposed], [Total Admissions] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0%";
m.Description = @"Admissions Exposed / all admissions in context (as in SQL query 19).";

// Clinical / Therapeutic Orders per Admission
m = t.Measures.Contains(@"Therapeutic Orders per Admission") ? t.Measures[@"Therapeutic Orders per Admission"] : t.AddMeasure(@"Therapeutic Orders per Admission");
m.Expression = @"DIVIDE ( [Therapeutic Orders], [Total Admissions] )";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0";
m.Description = @"Therapeutic orders / all admissions in context.";

// Clinical / Median Order Hours
m = t.Measures.Contains(@"Median Order Hours") ? t.Measures[@"Median Order Hours"] : t.AddMeasure(@"Median Order Hours");
m.Expression = @"CALCULATE (
    PERCENTILE.INC ( fact_medication_orders[order_duration_hours], 0.5 ),
    fact_medication_orders[drug_type] <> ""BASE"",
    NOT CONTAINSSTRING ( fact_medication_orders[drug_name_normalized], ""flush"" ),
    fact_medication_orders[has_inverted_times] = FALSE ()
)";
m.DisplayFolder = @"Clinical";
m.FormatString = @"0.0";
m.Description = @"Median order duration (hours) of therapeutic orders, excluding orders whose stop time precedes the start time (has_inverted_times).";

// Data Quality / Min Cell Size
m = t.Measures.Contains(@"Min Cell Size") ? t.Measures[@"Min Cell Size"] : t.AddMeasure(@"Min Cell Size");
m.Expression = @"5";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"0";
m.Description = @"Small-cell threshold used by the ""(display)"" measures. Matches manifest.json min_cell_size / HI_MIN_CELL_SIZE (default 5).";

// Data Quality / DQ Checks
m = t.Measures.Contains(@"DQ Checks") ? t.Measures[@"DQ Checks"] : t.AddMeasure(@"DQ Checks");
m.Expression = @"COUNTROWS ( rpt_data_quality_checks )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Validation checks in the latest validation run (rpt_data_quality_checks).";

// Data Quality / DQ Checks Passed
m = t.Measures.Contains(@"DQ Checks Passed") ? t.Measures[@"DQ Checks Passed"] : t.AddMeasure(@"DQ Checks Passed");
m.Expression = @"CALCULATE ( [DQ Checks], rpt_data_quality_checks[status] = ""pass"" )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Checks with status = ""pass"".";

// Data Quality / DQ Checks Flagged
m = t.Measures.Contains(@"DQ Checks Flagged") ? t.Measures[@"DQ Checks Flagged"] : t.AddMeasure(@"DQ Checks Flagged");
m.Expression = @"CALCULATE ( [DQ Checks], rpt_data_quality_checks[status] <> ""pass"" )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Checks with any status other than ""pass"" (flagged rows found).";

// Data Quality / DQ Error Flags
m = t.Measures.Contains(@"DQ Error Flags") ? t.Measures[@"DQ Error Flags"] : t.AddMeasure(@"DQ Error Flags");
m.Expression = @"CALCULATE (
    [DQ Checks],
    rpt_data_quality_checks[status] <> ""pass"",
    rpt_data_quality_checks[severity] = ""error""
)";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Flagged checks with severity = ""error"" (these fail the pipeline).";

// Data Quality / DQ Pass Rate
m = t.Measures.Contains(@"DQ Pass Rate") ? t.Measures[@"DQ Pass Rate"] : t.AddMeasure(@"DQ Pass Rate");
m.Expression = @"DIVIDE ( [DQ Checks Passed], [DQ Checks] )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"0.0%";
m.Description = @"DQ Checks Passed / DQ Checks.";

// Data Quality / DQ Flagged Rows
m = t.Measures.Contains(@"DQ Flagged Rows") ? t.Measures[@"DQ Flagged Rows"] : t.AddMeasure(@"DQ Flagged Rows");
m.Expression = @"SUM ( rpt_data_quality_checks[flagged_rows] )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Sum of flagged_rows across checks in the latest run.";

// Data Quality / DQ Status
m = t.Measures.Contains(@"DQ Status") ? t.Measures[@"DQ Status"] : t.AddMeasure(@"DQ Status");
m.Expression = @"IF ( [DQ Error Flags] > 0, ""Attention: error-severity checks failing"", ""Healthy: no error-severity failures"" )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"";
m.Description = @"Overall status text for the DQ card: any error-severity flag = ""Attention"".";

// Data Quality / Tables Monitored
m = t.Measures.Contains(@"Tables Monitored") ? t.Measures[@"Tables Monitored"] : t.AddMeasure(@"Tables Monitored");
m.Expression = @"COUNTROWS ( rpt_pipeline_status )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Source tables tracked by the ingestion pipeline (rpt_pipeline_status).";

// Data Quality / Rejected Rows
m = t.Measures.Contains(@"Rejected Rows") ? t.Measures[@"Rejected Rows"] : t.AddMeasure(@"Rejected Rows");
m.Expression = @"SUM ( rpt_pipeline_status[rejected_rows] )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Rows rejected by the loader in each table's latest run.";

// Data Quality / Duplicate Key Rows
m = t.Measures.Contains(@"Duplicate Key Rows") ? t.Measures[@"Duplicate Key Rows"] : t.AddMeasure(@"Duplicate Key Rows");
m.Expression = @"SUM ( rpt_pipeline_status[duplicate_key_rows] )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Duplicate primary-key rows found in each table's latest run.";

// Data Quality / Last Successful Table Load (UTC)
m = t.Measures.Contains(@"Last Successful Table Load (UTC)") ? t.Measures[@"Last Successful Table Load (UTC)"] : t.AddMeasure(@"Last Successful Table Load (UTC)");
m.Expression = @"MAX ( rpt_pipeline_status[last_successful_load_at] )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"yyyy-mm-dd hh:nn ""UTC""";
m.Description = @"Most recent last_successful_load_at across source tables (UTC).";

// Data Quality / Last Successful Ingestion (UTC)
m = t.Measures.Contains(@"Last Successful Ingestion (UTC)") ? t.Measures[@"Last Successful Ingestion (UTC)"] : t.AddMeasure(@"Last Successful Ingestion (UTC)");
m.Expression = @"CALCULATE ( MAX ( ingestion_runs[finished_at] ), ingestion_runs[status] = ""succeeded"" )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"yyyy-mm-dd hh:nn ""UTC""";
m.Description = @"finished_at of the latest ingestion run with status = ""succeeded"" (UTC).";

// Data Quality / Hours Since Last Ingestion
m = t.Measures.Contains(@"Hours Since Last Ingestion") ? t.Measures[@"Hours Since Last Ingestion"] : t.AddMeasure(@"Hours Since Last Ingestion");
m.Expression = @"VAR last = [Last Successful Ingestion (UTC)]
RETURN
    IF ( NOT ISBLANK ( last ), DIVIDE ( DATEDIFF ( last, UTCNOW (), MINUTE ), 60 ) )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0.0";
m.Description = @"Hours between the last successful ingestion and now (UTCNOW at refresh / query time). Freshness indicator.";

// Data Quality / Freshness Status
m = t.Measures.Contains(@"Freshness Status") ? t.Measures[@"Freshness Status"] : t.AddMeasure(@"Freshness Status");
m.Expression = @"VAR h = [Hours Since Last Ingestion]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( h ), ""No successful ingestion recorded"",
        h <= 24, ""Fresh (under 24 h)"",
        h <= 168, ""Stale (over 1 day)"",
        ""Stale (over 7 days)""
    )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"";
m.Description = @"Freshness label: <= 24 h ""Fresh"", <= 168 h ""Stale (over 1 day)"", else ""Stale (over 7 days)"". The demo extract is static, so ""Stale"" is expected.";

// Data Quality / Avg Column Null %
m = t.Measures.Contains(@"Avg Column Null %") ? t.Measures[@"Avg Column Null %"] : t.AddMeasure(@"Avg Column Null %");
m.Expression = @"DIVIDE ( AVERAGE ( rpt_missingness[null_pct] ), 100 )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"0.0%";
m.Description = @"Mean null share over profiled source columns (rpt_missingness[null_pct] is 0-100, so divide by 100).";

// Data Quality / Columns Over 50% Null
m = t.Measures.Contains(@"Columns Over 50% Null") ? t.Measures[@"Columns Over 50% Null"] : t.AddMeasure(@"Columns Over 50% Null");
m.Expression = @"CALCULATE ( COUNTROWS ( rpt_missingness ), rpt_missingness[null_pct] > 50 )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Profiled source columns that are more than 50% null.";

// Data Quality / Benchmark Runs
m = t.Measures.Contains(@"Benchmark Runs") ? t.Measures[@"Benchmark Runs"] : t.AddMeasure(@"Benchmark Runs");
m.Expression = @"COALESCE ( COUNTROWS ( query_benchmarks ), 0 )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0";
m.Description = @"Benchmark measurements recorded (meta.query_benchmarks). 0 when empty.";

// Data Quality / Latest Median ms
m = t.Measures.Contains(@"Latest Median ms") ? t.Measures[@"Latest Median ms"] : t.AddMeasure(@"Latest Median ms");
m.Expression = @"VAR lastTs = MAX ( query_benchmarks[benchmarked_at] )
RETURN
    CALCULATE ( AVERAGE ( query_benchmarks[median_ms] ), query_benchmarks[benchmarked_at] = lastTs )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0.000";
m.Description = @"Median runtime (ms) of the most recent benchmark in context (latest benchmarked_at). Use with case_name and variant on the axis/legend.";

// Data Quality / Benchmark Speedup
m = t.Measures.Contains(@"Benchmark Speedup") ? t.Measures[@"Benchmark Speedup"] : t.AddMeasure(@"Benchmark Speedup");
m.Expression = @"DIVIDE (
    CALCULATE ( [Latest Median ms], query_benchmarks[variant] = ""baseline"" ),
    CALCULATE ( [Latest Median ms], query_benchmarks[variant] = ""optimized"" )
)";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"#,0.0""x""";
m.Description = @"Baseline / optimized latest median runtime for the case(s) in context.";

// Data Quality / Benchmark Status
m = t.Measures.Contains(@"Benchmark Status") ? t.Measures[@"Benchmark Status"] : t.AddMeasure(@"Benchmark Status");
m.Expression = @"IF (
    [Benchmark Runs] = 0,
    ""No query benchmarks recorded yet - run the benchmark job and refresh"",
    FORMAT ( DISTINCTCOUNT ( query_benchmarks[case_name] ), ""0"" ) & "" benchmark cases, latest ""
        & FORMAT ( MAX ( query_benchmarks[benchmarked_at] ), ""yyyy-mm-dd hh:nn"" ) & "" UTC""
)";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"";
m.Description = @"Card text for the benchmark panel; handles an empty benchmarks table.";

// Data Quality / KPI Reconciliation Mismatches
m = t.Measures.Contains(@"KPI Reconciliation Mismatches") ? t.Measures[@"KPI Reconciliation Mismatches"] : t.AddMeasure(@"KPI Reconciliation Mismatches");
m.Expression = @"VAR pts = CALCULATE ( [Total Patients], REMOVEFILTERS () )
VAR adm = CALCULATE ( [Total Admissions], REMOVEFILTERS () )
VAR app = CALCULATE ( [Admissions per Patient], REMOVEFILTERS () )
VAR los = CALCULATE ( [Median LOS (days)], REMOVEFILTERS () )
VAR icu = CALCULATE ( [ICU Admission %], REMOVEFILTERS () )
VAR mort = CALCULATE ( [Hospital Mortality %], REMOVEFILTERS () )
VAR rden = CALCULATE ( [Eligible Index Admissions], REMOVEFILTERS () )
VAR rnum = CALCULATE ( [Readmissions 30d], REMOVEFILTERS () )
VAR rpct = CALCULATE ( [Readmission 30d %], REMOVEFILTERS () )
VAR upct = CALCULATE ( [Unplanned Readmission 30d %], REMOVEFILTERS () )
RETURN
    IF (
        ISEMPTY ( rpt_executive_kpis ),
        BLANK (),
        INT ( pts <> MAX ( rpt_executive_kpis[total_patients] ) )
            + INT ( adm <> MAX ( rpt_executive_kpis[total_admissions] ) )
            + INT ( ROUND ( app, 2 ) <> MAX ( rpt_executive_kpis[admissions_per_patient] ) )
            + INT ( ABS ( los - MAX ( rpt_executive_kpis[median_los_days] ) ) > 0.000001 )
            + INT ( ROUND ( icu * 100, 1 ) <> MAX ( rpt_executive_kpis[icu_admission_pct] ) )
            + INT ( ROUND ( mort * 100, 1 ) <> MAX ( rpt_executive_kpis[hospital_mortality_pct] ) )
            + INT ( rden <> MAX ( rpt_executive_kpis[readmission_denominator] ) )
            + INT ( rnum <> MAX ( rpt_executive_kpis[readmission_numerator] ) )
            + INT ( ROUND ( rpct * 100, 1 ) <> MAX ( rpt_executive_kpis[readmission_30d_pct] ) )
            + INT ( ROUND ( upct * 100, 1 ) <> MAX ( rpt_executive_kpis[unplanned_readmission_30d_pct] ) )
    )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"0";
m.Description = @"Number of headline KPIs where the DAX value (all filters removed) differs from the SQL value in rpt_executive_kpis, using the SQL rounding (1 dp for percentages, 2 dp for admissions per patient). 0 = DAX reproduces SQL.";

// Data Quality / KPI Reconciliation Status
m = t.Measures.Contains(@"KPI Reconciliation Status") ? t.Measures[@"KPI Reconciliation Status"] : t.AddMeasure(@"KPI Reconciliation Status");
m.Expression = @"VAR m = [KPI Reconciliation Mismatches]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( m ), ""rpt_executive_kpis not loaded"",
        m = 0, ""DAX = SQL for all 10 headline KPIs"",
        FORMAT ( m, ""0"" ) & "" of 10 headline KPIs differ from SQL - check measures""
    )";
m.DisplayFolder = @"Data Quality";
m.FormatString = @"";
m.Description = @"Card text for the SQL-vs-DAX reconciliation (10 headline KPIs).";

Info("Created or updated 105 measures in _Measures.");
