# Copy to .env and adjust. Never commit .env.

# --- Dataset mode -------------------------------------------------
# demo : public MIMIC-IV Clinical Database Demo v2.2 (open access, ODbL)
# full : credentialed MIMIC-IV v3.1 files you have downloaded yourself
HI_DATASET_MODE=demo
HI_DEMO_DIR=data/raw
HI_FULL_DIR=data/full/mimiciv/3.1

# Rows per streamed batch during ingestion (memory bound)
HI_BATCH_ROWS=250000

# --- PostgreSQL ----------------------------------------------------
HI_PG_HOST=localhost
HI_PG_PORT=5433
HI_PG_USER=hi_admin
HI_PG_PASSWORD=
HI_PG_DB=hospital_intel

# --- Optional BigQuery backend (credentialed access only) ----------
# HI_BQ_PROJECT=your-gcp-project
# HI_BQ_DATASET=hospital_intel
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Reporting -----------------------------------------------------
# Aggregate cells with fewer patients than this are suppressed in dashboards
HI_MIN_CELL_SIZE=5
